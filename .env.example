# Application
APP_URL=http://localhost:8080
APP_ENV=development            # development | production
APP_TIMEZONE=America/New_York
SESSION_SECURE=false           # true when serving over HTTPS

# Supabase Postgres — use the SESSION POOLER host if your server is IPv4-only:
#   Host: aws-0-<region>.pooler.supabase.com   User: postgres.<project-ref>
# Direct connection (IPv6): db.<project-ref>.supabase.co with user postgres
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.mtwnxuklnmauimjzqynw
DB_PASSWORD=
DB_SSLMODE=require

# Supabase project (Storage API)
SUPABASE_URL=https://mtwnxuklnmauimjzqynw.supabase.co
SUPABASE_SERVICE_KEY=

# Email notifications — Resend API (preferred). Until your domain is verified
# in the Resend dashboard, use MAIL_FROM=onboarding@resend.dev (delivers only
# to the Resend account owner's email). After verifying intuites.com, set
# MAIL_FROM=noreply@intuites.com (or similar).
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME="Staffing Accounting"

# SMTP fallback (used only when RESEND_API_KEY is empty)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudflare Turnstile (bot protection on both login pages).
# Leave blank to disable (e.g. offline local dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
